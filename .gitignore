# =============================================================================
# .gitignore cho Dự án B2B Procurement System (Spring Boot + Gradle + Docker)
# =============================================================================

### --- 1. Gradle & Build Tools ---
.gradle/
build/
bin/
out/
target/
dist/
.nb-gradle/

# Đảm bảo KHÔNG bỏ qua Gradle Wrapper (cần thiết để build trên máy mới / CI/CD)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Giữ lại các thư mục hợp lệ bên trong src nếu có trùng tên
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/target/
!**/src/test/**/target/

### --- 2. Java & Compiled Artifacts ---
*.class
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.7z

# Bỏ qua file .jar build ra nhưng giữ lại gradle wrapper jar
*.jar
!gradle/wrapper/gradle-wrapper.jar

# JVM Crash Logs & Memory Dumps
hs_err_pid*
replay_pid*
core.*
*.hprof
*.dump

### --- 3. Cấu hình & Biến môi trường bảo mật (Sensitive Credentials) ---
# Environment variables
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Spring configuration files chứa credentials cục bộ
application-local.yml
application-local.properties
application-local.json
application-secret.yml
application-secret.properties
application-override.yml
application-override.properties
secrets.yml
secrets.properties

# SSL / TLS / Cryptographic Keys & Keystores
*.key
*.pem
*.keystore
*.jks
*.p12
*.pfx
*.crt
*.cer
*.der

### --- 4. Logs, Runtime & Thư mục tạm ---
logs/
*.log
*.log.*
*.stdout
*.stderr
*.pid
*.seed
*.pid.lock
tmp/
temp/
.temp/

### --- 5. Uploads, Media & Local Storage ---
# Tránh commit file người dùng tải lên môi trường dev cục bộ
uploads/
upload/
storage/
attachments/
media/

### --- 6. Database Cục bộ & Dữ liệu Docker ---
# Embedded DB files
*.db
*.sqlite
*.sqlite3
*.h2.db
*.trace.db

# Thư mục volume / mount của Database khi chạy cục bộ
postgres-data/
pgdata/
mysql-data/
redis-data/
data/

# Database dumps
*.dump
*.sql.gz
*.sql.tar.gz

### --- 7. Docker & Local Infrastructure Overrides ---
# File override chỉ dùng cho dev cục bộ, không đưa lên git
docker-compose.override.yml
docker-compose.local.yml
.docker/

### --- 8. IDEs & Code Editors ---
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea_modules/
out/

# Eclipse & Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/

# JetBrains Fleet & Cursor
.fleet/
.cursor/

### --- 9. Code Quality & Test Reports ---
# JaCoCo (Coverage)
*.exec
jacoco.db
build/reports/jacoco/

# SonarQube / SonarLint
.scannerwork/
.sonar/
.sonarlint/

### --- 10. Node.js / Frontend (Nếu có tích hợp Dashboard / Web) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/

### --- 11. Hệ điều hành (OS Files) ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

### --- 12. Backup & Editor Swap Files ---
*.bak
*.swp
*.swo
*~
*.patch
*.diff

### --- 13. AI Tools & Trợ lý code ---
HELP.md
.gemini/
.claude/
.copilot/
AGENTS.md
PROJECT_STATUS.md

### --- 14. Postman Collections & Environments ---
*.postman_collection.json
*.postman_environment.json
